{
  "name": "civi-times",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "ingest:dry": "node --experimental-strip-types apps/ingest/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
